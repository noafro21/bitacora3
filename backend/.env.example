# Ejemplo de variables de entorno para el backend
# Copia este archivo como `.env` dentro de la carpeta backend/ y completa los valores.

# Cadena de conexión a MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/<nombre-bd>?retryWrites=true&w=majority

# Puerto en el que corre el servidor (opcional, por defecto 3000)
PORT=3000
